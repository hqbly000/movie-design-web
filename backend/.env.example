# ============================================================
# 交点影视 JIAO DIAN FILM AND TELEVISION · 后端环境变量示例
# 复制为 .env 后按需修改
# ============================================================

# 数据库连接（MySQL 8，库名 lightisle；该实例存在他人业务库，禁止触碰）
# 数据库连接串。开发建议连老服务器 124.223.29.189 的 MySQL，走 SSH 隧道：
#   1) 先跑 scripts\dev-db-tunnel.bat（Win）或 bash scripts/dev-db-tunnel.sh --bg
#   2) 本机 127.0.0.1:13306 即服务器上的 3306
# DB_URL=mysql+pymysql://lightisle:52wza4nik9p10o3drsgv8thl@127.0.0.1:13306/lightisle?charset=utf8mb4
# 连局域网自有 MySQL 时用：
DB_URL=mysql+pymysql://root:12345678@10.66.237.199:3306/lightisle?charset=utf8mb4

# JWT（HS256）
JWT_SECRET=lightisle-dev-secret-please-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 上传目录（相对 backend 工程根）
UPLOAD_DIR=uploads
# 上传大小上限（MB）与允许的扩展名
MAX_UPLOAD_MB=5
ALLOWED_IMAGE_EXTS=jpg,jpeg,png,webp

# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# 站点基础地址（生成分享链接 share_url 使用；开发期指向官网工程端口 5173）
SITE_BASE_URL=http://localhost:5173

# 公开站点缓存时长（秒）
SITE_CACHE_TTL=60

# 启动时是否灌样例数据（轮播/作品/荣誉/视频等演示内容）
# 开发：true（空库也能看到完整界面）；生产：false（内容由客户在后台上传，
# 否则每次重启都会把运营删掉的样例数据补回来）
SEED_ON_STARTUP=true
