# ============================================================
# 光屿摄影 LIGHT ISLE STUDIO · 后端环境变量示例
# 复制为 .env 后按需修改
# ============================================================

# 数据库连接（MySQL 8，库名 lightisle；该实例存在他人业务库，禁止触碰）
DB_URL=mysql+pymysql://root:12345678@10.66.237.199:3306/lightisle?charset=utf8mb4

# JWT（HS256）
JWT_SECRET=lightisle-dev-secret-please-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 上传目录（相对 backend 工程根）
UPLOAD_DIR=uploads
# 上传大小上限（MB）与允许的扩展名
MAX_UPLOAD_MB=5
ALLOWED_IMAGE_EXTS=jpg,jpeg,png,webp

# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# 站点基础地址（生成分享链接 share_url 使用；开发期指向官网工程端口 5173）
SITE_BASE_URL=http://localhost:5173

# 公开站点缓存时长（秒）
SITE_CACHE_TTL=60
