---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import Works from '@/components/Works.astro';
import Photographers from '@/components/Photographers.astro';
import News from '@/components/News.astro';
import About from '@/components/About.astro';
import ContactBanner from '@/components/ContactBanner.astro';
import Footer from '@/components/Footer.astro';
import VideoModal from '@/components/VideoModal.astro';
import { getHomeContent } from '@/content';
import '@/styles/global.css';

const page = await getHomeContent();
---
<BaseLayout title={page.site.title}>
  <Header site={page.site} />

  <main>
    <Hero hero={page.hero} />

    <div class="shell">
      <Works
        works={page.works}
        defaultChannelId={page.hero.defaultChannelId}
        channels={page.hero.channels}
      />
      <Photographers photographers={page.photographers} />
      <News news={page.news} />
      <About about={page.about} />
    </div>

    <ContactBanner cta={page.cta} />
  </main>

  <Footer footer={page.footer} />
  <VideoModal />

  <script>
    const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');

    const syncHeaderState = () => {
      siteHeader?.classList.toggle('is-scrolled', window.scrollY > 64);
    };

    syncHeaderState();
    window.addEventListener('scroll', syncHeaderState, { passive: true });

    const playBtn = document.querySelector('#playBtn');
    const modal = document.querySelector('#videoModal');
    const closeModal = document.querySelector('#closeModal');
    const videoSlot = document.querySelector('#videoSlot');

    const closeVideo = () => {
      if (!(modal instanceof HTMLElement) || !(videoSlot instanceof HTMLElement)) return;
      modal.classList.remove('show');
      modal.setAttribute('aria-hidden', 'true');
      const video = videoSlot.querySelector('video');
      if (video) {
        video.pause();
        video.removeAttribute('src');
        video.load();
      }
    };

    playBtn?.addEventListener('click', () => {
      if (!(playBtn instanceof HTMLElement) || !(modal instanceof HTMLElement) || !(videoSlot instanceof HTMLElement)) return;

      const src = playBtn.dataset.videoSrc;
      const poster = playBtn.dataset.poster;

      if (src) {
        const video = document.createElement('video');
        video.controls = true;
        video.autoplay = true;
        video.preload = 'metadata';
        video.playsInline = true;
        if (poster) video.poster = poster;
        video.src = src;
        videoSlot.replaceChildren(video);
      }

      modal.classList.add('show');
      modal.setAttribute('aria-hidden', 'false');
    });

    closeModal?.addEventListener('click', closeVideo);
    modal?.addEventListener('click', (event) => {
      if (event.target === modal) closeVideo();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeVideo();
    });


    const carouselTracks = [...document.querySelectorAll<HTMLElement>('[data-carousel-track]')];

    const updateCarouselButtons = (track: HTMLElement) => {
      const id = track.id;
      if (!id) return;

      const prev = document.querySelector<HTMLButtonElement>(`[data-carousel-prev="${id}"]`);
      const next = document.querySelector<HTMLButtonElement>(`[data-carousel-next="${id}"]`);
      const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);

      if (prev) prev.disabled = track.scrollLeft <= 4;
      if (next) next.disabled = track.scrollLeft >= maxScroll - 4;
    };

    const scrollCarousel = (id: string, direction: -1 | 1) => {
      const track = document.getElementById(id);
      if (!(track instanceof HTMLElement)) return;

      const firstCard = track.querySelector<HTMLElement>('.work-card');
      const step = firstCard
        ? firstCard.getBoundingClientRect().width + 1
        : Math.max(track.clientWidth * 0.75, 280);

      track.scrollBy({ left: step * direction, behavior: 'smooth' });
    };

    document.querySelectorAll<HTMLButtonElement>('[data-carousel-prev]').forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.dataset.carouselPrev;
        if (id) scrollCarousel(id, -1);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-carousel-next]').forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.dataset.carouselNext;
        if (id) scrollCarousel(id, 1);
      });
    });

    carouselTracks.forEach((track) => {
      updateCarouselButtons(track);
      track.addEventListener('scroll', () => updateCarouselButtons(track), { passive: true });
    });

    window.addEventListener('resize', () => {
      carouselTracks.forEach(updateCarouselButtons);
    });

    // 统一栏目切换：Hero Tab 与作品区 Pill 共用，同时驱动封面筛选与 Hero 特性面板
    const channelTabsAll = [...document.querySelectorAll<HTMLButtonElement>('[data-channel-tab]')];
    const featureSets = [...document.querySelectorAll<HTMLElement>('[data-channel-features]')];
    let applyWorksFilter: (channelId: string) => void = () => {};

    const setChannel = (channelId: string) => {
      channelTabsAll.forEach((tab) => {
        tab.setAttribute('aria-selected', String(tab.dataset.channelTab === channelId));
      });
      featureSets.forEach((set) => {
        set.hidden = set.dataset.channelFeatures !== channelId;
      });
      applyWorksFilter(channelId);
    };

    channelTabsAll.forEach((tab) => {
      tab.addEventListener('click', () => {
        const channelId = tab.dataset.channelTab;
        if (channelId) setChannel(channelId);
      });
    });

    // 作品区 · 层级轮播 (Cover Flow)
    const worksTrack = document.getElementById('worksTrack');
    if (worksTrack) {
      const worksGallery = worksTrack.closest<HTMLElement>('.work-gallery');
      const allCards = [...worksTrack.querySelectorAll<HTMLElement>('.work-card')];
      let activeIndex = 0;
      const INITIAL_FOCUS = 2; // 默认聚焦第 3 件，左侧自然露出两张，构图更平衡

      const visibleCards = () => allCards.filter((card) => !card.hidden);

      const layout = () => {
        const vis = visibleCards();
        if (!vis.length) return;
        const shift = (vis[0].offsetWidth || 320) * 0.62;
        vis.forEach((card, i) => {
          const offset = i - activeIndex;
          const dist = Math.min(Math.abs(offset), 3);
          const tx = offset * shift;
          const tz = -dist * 60;
          const scale = 1 - dist * 0.12;
          const rot = offset * -7;
          card.style.transform = `translateX(${tx}px) translateZ(${tz}px) rotateY(${rot}deg) scale(${scale})`;
          card.style.opacity = `${Math.max(0.3, 1 - dist * 0.25)}`;
          card.style.filter = dist === 0 ? '' : `blur(${dist * 4}px)`;
          card.style.zIndex = `${100 - dist}`;
          const isActive = offset === 0;
          card.classList.toggle('is-active', isActive);
          card.setAttribute('aria-hidden', String(!isActive));
          card.tabIndex = isActive ? 0 : -1;
        });
      };

      const applyFilter = (channelId: string) => {
        allCards.forEach((card) => {
          card.hidden = card.dataset.workChannel !== channelId;
        });
        activeIndex = Math.min(INITIAL_FOCUS, visibleCards().length - 1);
        layout();
      };
      applyWorksFilter = applyFilter;

      const go = (dir: number) => {
        const vis = visibleCards();
        if (!vis.length) return;
        activeIndex = Math.max(0, Math.min(vis.length - 1, activeIndex + dir));
        layout();
      };

      // 上一件 / 下一件（SectionHeading 圆按钮 + 内联贴边箭头共用）
      document
        .querySelectorAll<HTMLButtonElement>('[data-carousel-prev="worksTrack"]')
        .forEach((btn) => btn.addEventListener('click', () => go(-1)));
      document
        .querySelectorAll<HTMLButtonElement>('[data-carousel-next="worksTrack"]')
        .forEach((btn) => btn.addEventListener('click', () => go(1)));
      document.querySelectorAll<HTMLButtonElement>('[data-arrow]').forEach((btn) => {
        btn.addEventListener('click', () => go(btn.dataset.arrow === 'next' ? 1 : -1));
      });

      // 点击侧卡 → 朝被点击方向步进一格（不直接跳目标）
      allCards.forEach((card) => {
        card.addEventListener('click', (event) => {
          if (card.classList.contains('is-active')) return;
          event.preventDefault();
          const vis = visibleCards();
          const idx = vis.indexOf(card);
          if (idx >= 0) go(idx > activeIndex ? 1 : -1);
        });
      });

      // 指针拖拽 / 触摸滑动：跟手平移 + 松手吸附（cover flow 最直觉的交互）
      let pointerDown = false;
      let startX = 0;
      let startY = 0;
      let dragDX = 0;
      let dragMoved = false;
      let suppressClick = false;

      const visFirstWidth = () => {
        const vis = visibleCards();
        return vis[0]?.offsetWidth || 320;
      };

      const onPointerDown = (event: PointerEvent) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        pointerDown = true;
        dragMoved = false;
        suppressClick = false;
        startX = event.clientX;
        startY = event.clientY;
        dragDX = 0;
        worksTrack.setPointerCapture?.(event.pointerId);
        worksTrack.classList.add('is-grabbing');
      };

      const onPointerMove = (event: PointerEvent) => {
        if (!pointerDown) return;
        const dx = event.clientX - startX;
        const dy = event.clientY - startY;
        if (!dragMoved && Math.hypot(dx, dy) > 6) dragMoved = true;
        if (dragMoved) {
          dragDX = dx;
          worksTrack.style.transform = `translateX(${dx}px)`;
          event.preventDefault();
        }
      };

      const onPointerUp = (event: PointerEvent) => {
        if (!pointerDown) return;
        pointerDown = false;
        worksTrack.classList.remove('is-grabbing');
        worksTrack.releasePointerCapture?.(event.pointerId);
        worksTrack.style.transform = '';
        if (dragMoved) {
          const threshold = visFirstWidth() * 0.22;
          if (dragDX <= -threshold) go(1);
          else if (dragDX >= threshold) go(-1);
          suppressClick = true;
        }
      };

      worksTrack.addEventListener('pointerdown', onPointerDown);
      worksTrack.addEventListener('pointermove', onPointerMove);
      worksTrack.addEventListener('pointerup', onPointerUp);
      worksTrack.addEventListener('pointercancel', onPointerUp);

      // 拖拽后拦截误触发的卡片点击（避免“拖动焦点卡却误进详情”）
      worksTrack.addEventListener(
        'click',
        (event) => {
          if (suppressClick) {
            event.preventDefault();
            event.stopPropagation();
            suppressClick = false;
          }
        },
        true
      );

      // 滚轮：仅响应 trackpad 横向滑动（deltaX 明显），纵向滚轮放行页面滚动
      let wheelLock = false;
      worksTrack.addEventListener(
        'wheel',
        (event) => {
          if (Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
          event.preventDefault();
          if (wheelLock) return;
          wheelLock = true;
          go(event.deltaX > 0 ? 1 : -1);
          window.setTimeout(() => (wheelLock = false), 320);
        },
        { passive: false }
      );

      // 键盘左右切换（焦点在轮播内时）
      worksTrack.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') go(-1);
        if (event.key === 'ArrowRight') go(1);
      });

      // 重新布局：进入视口 / 尺寸变化 / 初次渲染
      const io = new IntersectionObserver(
        (entries) => entries.forEach((entry) => { if (entry.isIntersecting) layout(); }),
        { threshold: 0.05 }
      );
      io.observe(worksTrack);
      window.addEventListener('resize', layout);
      requestAnimationFrame(layout);
      setTimeout(layout, 360);

      // 初始栏目
      const defaultCh = worksGallery?.dataset.defaultChannel || 'video';
      setChannel(defaultCh);
    }

    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav a')];
    const sectionIds = navLinks
      .map((link) => link.getAttribute('href'))
      .filter((href): href is string => Boolean(href?.startsWith('#')))
      .map((href) => href.slice(1));

    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((section): section is HTMLElement => section !== null);

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (!visible) return;
        navLinks.forEach((link) => {
          link.classList.toggle('active', link.getAttribute('href') === `#${visible.target.id}`);
        });
      },
      { rootMargin: '-25% 0px -60% 0px', threshold: [0, 0.1, 0.3] }
    );

    sections.forEach((section) => observer.observe(section));
  </script>
</BaseLayout>
