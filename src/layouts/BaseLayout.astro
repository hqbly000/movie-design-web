---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '摄影、影视与品牌视觉作品展示概念站'
} = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#181818" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
