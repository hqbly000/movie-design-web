---
import SectionHeading from './SectionHeading.astro';
import type { WorkItem, HeroChannel } from '@/types/content';
import { getWorkPath } from '@/content';

interface Props {
  works: WorkItem[];
  defaultChannelId: string;
  channels: HeroChannel[];
}

const { works, defaultChannelId, channels } = Astro.props;

const items = works
  .filter((item) => item.visible)
  .sort((a, b) => {
    if (a.channelId === b.channelId) return a.sort - b.sort;
    return a.channelId.localeCompare(b.channelId);
  });
---

<section class="content-section deferred-section" id="works">
  <SectionHeading title="作品展示" subtitle="Exhibition of works" />

  <div class="work-filters" role="tablist" aria-label="作品栏目筛选">
    {
      channels.map((ch) => (
        <button
          type="button"
          class="work-pill"
          role="tab"
          data-channel-tab={ch.id}
          aria-selected={ch.id === defaultChannelId ? 'true' : 'false'}
        >
          {ch.label}
        </button>
      ))
    }
  </div>

  <div class="work-gallery" data-default-channel={defaultChannelId}>
    <div class="work-stage">
      <div class="work-track" id="worksTrack">
        {
          items.map((work) => (
            <a
              class="work-card"
              href={getWorkPath(work)}
              aria-label={`查看${work.title}作品详情`}
              data-work-channel={work.channelId}
              draggable="false"
            >
              <img
                src={work.cover}
                alt={work.alt}
                width="900"
                height="1200"
                loading="lazy"
                decoding="async"
                draggable="false"
              />
              <div class="work-shade" aria-hidden="true"></div>
              <span class="work-tag" aria-hidden="true">{work.subtitle}</span>
              <div class="work-copy">
                <h3>{work.title}</h3>
                <span class="work-cta">查看项目 →</span>
              </div>
            </a>
          ))
        }
      </div>
      <button class="work-arrow work-arrow-prev" type="button" data-arrow="prev" aria-label="查看上一件作品">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5 10.5 12 14 15.5" /></svg>
      </button>
      <button class="work-arrow work-arrow-next" type="button" data-arrow="next" aria-label="查看下一件作品">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 8.5 13.5 12 10 15.5" /></svg>
      </button>
    </div>
  </div>
</section>
