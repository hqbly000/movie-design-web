---
import type { HomeContent } from '@/types/content';

interface Props {
  site: HomeContent['site'];
  hrefPrefix?: string;
  activeHref?: string;
}

const { site, hrefPrefix = '', activeHref = '#home' } = Astro.props;
---
<header class="topbar" data-site-header>
  <div class="shell topbar-inner">
    <a class="brand" href={`${hrefPrefix}#home`} aria-label={`${site.brandCn}首页`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>
        <span class="brand-cn">{site.brandCn}</span>
        <span class="brand-en">{site.brandEn}</span>
      </span>
    </a>

    <nav class="nav" aria-label="主导航">
      {site.nav.map((item) => (
        <a href={`${hrefPrefix}${item.href}`} class:list={{ active: item.href === activeHref }}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
